+/**
+ * @file
+ * SDR to HDR grading through libhdrgrading: SDR video in, single-layer PQ
+ * over BT.2020 out, with the mastering display and each frame's HDR10+ and
+ * SMPTE ST 2094-50 metadata.
+ */
+
+#include <hdrgrading/hdrgrading.h>
+#include <hdrgrading/video.h>
+
+#include "libavutil/dict.h"
+#include "libavutil/eval.h"
+#include "libavutil/fifo.h"
+#include "libavutil/hdr_dynamic_metadata.h"
+#include "libavutil/mastering_display_metadata.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+
+#include "avfilter.h"
+#include "filters.h"
+#include "formats.h"
+#include "video.h"
+
+/* the session's time base when the frame rate changes: the frames between the input's land
+ * on their own times */
+#define SESSION_TIME_BASE (AVRational){ 1, 90000 }
+
+typedef struct HdrgStamp {
+    AVFrame *props; /* a sent frame's properties, no data */
+    int64_t pts;    /* its pts in the session's time base */
+} HdrgStamp;
+
+typedef struct LibHdrgradingContext {
+    const AVClass *class;
+
+    /* options */
+    int preset;
+    int temporal;
+    int latency;
+    int past, future;
+    int proxy;
+    int w, h;
+    AVRational rate;
+    int threads;
+    int gpu;
+    int flash_limit;
+    int dither;
+    AVDictionary *settings;
+
+    hdrg_context_t *hdrg;
+    hdrg_session_t *session;
+    hdrg_params_t params;
+    hdrg_display_caps_t caps;
+    hdrg_session_config_t config;
+    hdrg_session_format_t format;
+    AVRational session_tb;
+    AVFifo *stamps;  /* the sent frames' properties, oldest first */
+    int64_t sent;    /* frames sent: a missing pts */
+    float peak;      /* the rendition ceiling, the mastering display's maximum */
+} LibHdrgradingContext;
+
+static int hdrg_error(void *log, hdrg_status_t status, const char *what)
+{
+    av_log(log, AV_LOG_ERROR, "%s: %s\n", what, hdrg_status_string(status));
+
+    switch (status) {
+    case HDRG_ERR_NOMEM:
+        return AVERROR(ENOMEM);
+    case HDRG_ERR_INVALID_ARG:
+    case HDRG_ERR_INVALID_STATE:
+    case HDRG_ERR_NOT_FOUND:
+        return AVERROR(EINVAL);
+    case HDRG_ERR_UNSUPPORTED:
+    case HDRG_ERR_UNSUPPORTED_FORMAT:
+        return AVERROR(ENOSYS);
+    default:
+        return AVERROR_EXTERNAL;
+    }
+}
+
+static av_cold int init(AVFilterContext *ctx)
+{
+    LibHdrgradingContext *s = ctx->priv;
+    const AVDictionaryEntry *e = NULL;
+    hdrg_context_desc_t desc;
+    hdrg_status_t status;
+
+    hdrg_params_init(&s->params, s->preset);
+    hdrg_display_caps_init(&s->caps);
+    /* Y'CbCr output takes a BT.2020 container; the colors stay within Display P3 */
+    s->caps.gamut = HDRG_GAMUT_BT2020;
+
+    /* the settings after the preset, by the names of hdrg-cli's options */
+    while ((e = av_dict_iterate(s->settings, e))) {
+        char *end;
+        double value = av_strtod(e->value, &end);
+
+        if (end == e->value || *end) {
+            av_log(ctx, AV_LOG_ERROR, "Setting %s: '%s' is not a number.\n", e->key, e->value);
+            return AVERROR(EINVAL);
+        }
+
+        status = hdrg_setting_set(e->key, value, &s->params, &s->caps, NULL);
+        if (status != HDRG_OK) {
+            av_log(ctx, AV_LOG_ERROR, "Setting %s=%s: %s\n", e->key, e->value,
+                   hdrg_status_string(status));
+            return AVERROR(EINVAL);
+        }
+    }
+
+    hdrg_context_desc_init(&desc);
+    desc.thread_count = s->threads;
+    desc.gpu = s->gpu;
+
+    status = hdrg_context_create(&desc, &s->hdrg);
+    if (status != HDRG_OK)
+        return hdrg_error(ctx, status, "Cannot create the libhdrgrading context");
+
+    s->stamps = av_fifo_alloc2(16, sizeof(HdrgStamp), AV_FIFO_FLAG_AUTO_GROW);
+    if (!s->stamps)
+        return AVERROR(ENOMEM);
+
+    return 0;
+}
+
+static av_cold void uninit(AVFilterContext *ctx)
+{
+    LibHdrgradingContext *s = ctx->priv;
+    HdrgStamp stamp;
+
+    /* the frames the session still holds are released into their AVFrames */
+    hdrg_session_destroy(s->session);
+    s->session = NULL;
+    hdrg_context_destroy(s->hdrg);
+    s->hdrg = NULL;
+
+    while (s->stamps && av_fifo_read(s->stamps, &stamp, 1) >= 0)
+        av_frame_free(&stamp.props);
+    av_fifo_freep2(&s->stamps);
+}
+
+static const enum AVPixelFormat input_formats[] = {
+    AV_PIX_FMT_YUV420P,   AV_PIX_FMT_YUV422P,   AV_PIX_FMT_YUV444P,
+    AV_PIX_FMT_YUV420P10, AV_PIX_FMT_YUV422P10, AV_PIX_FMT_YUV444P10,
+    AV_PIX_FMT_YUV420P12, AV_PIX_FMT_YUV422P12, AV_PIX_FMT_YUV444P12,
+    AV_PIX_FMT_YUV420P16, AV_PIX_FMT_YUV422P16, AV_PIX_FMT_YUV444P16,
+    AV_PIX_FMT_NV12,      AV_PIX_FMT_NV16,      AV_PIX_FMT_NV24,
+    AV_PIX_FMT_P010,      AV_PIX_FMT_P012,      AV_PIX_FMT_P016,
+    AV_PIX_FMT_RGB24,     AV_PIX_FMT_RGB48,
+    AV_PIX_FMT_NONE
+};
+
+static const enum AVPixelFormat output_formats[] = {
+    AV_PIX_FMT_YUV420P10, AV_PIX_FMT_P010, AV_PIX_FMT_RGB48, AV_PIX_FMT_NONE
+};
+
+static const enum AVColorSpace input_spaces[] = {
+    AVCOL_SPC_BT709, AVCOL_SPC_BT470BG, AVCOL_SPC_SMPTE170M, AVCOL_SPC_BT2020_NCL,
+    AVCOL_SPC_UNSPECIFIED, -1
+};
+
+static int query_formats(const AVFilterContext *ctx,
+                         AVFilterFormatsConfig **cfg_in,
+                         AVFilterFormatsConfig **cfg_out)
+{
+    int ret;
+
+    if ((ret = ff_formats_ref(ff_make_pixel_format_list(input_formats), &cfg_in[0]->formats)) < 0 ||
+        (ret = ff_formats_ref(ff_make_format_list((const int *)input_spaces),
+                              &cfg_in[0]->color_spaces)) < 0 ||
+        (ret = ff_formats_ref(ff_all_color_ranges(), &cfg_in[0]->color_ranges)) < 0)
+        return ret;
+
+    if ((ret = ff_formats_ref(ff_make_pixel_format_list(output_formats), &cfg_out[0]->formats)) < 0 ||
+        (ret = ff_formats_ref(ff_make_formats_list_singleton(AVCOL_SPC_BT2020_NCL),
+                              &cfg_out[0]->color_spaces)) < 0 ||
+        (ret = ff_formats_ref(ff_make_formats_list_singleton(AVCOL_RANGE_MPEG),
+                              &cfg_out[0]->color_ranges)) < 0)
+        return ret;
+
+    return 0;
+}
+
+static int config_output(AVFilterLink *outlink)
+{
+    AVFilterContext *ctx = outlink->src;
+    LibHdrgradingContext *s = ctx->priv;
+    AVFilterLink *inlink = ctx->inputs[0];
+    FilterLink *il = ff_filter_link(inlink);
+    FilterLink *ol = ff_filter_link(outlink);
+    int64_t w = s->w, h = s->h;
+
+    /* one side 0 keeps the aspect ratio, as libhdrgrading resolves it */
+    if (!w && !h) {
+        w = inlink->w;
+        h = inlink->h;
+    } else if (!w) {
+        w = FFMAX(((int64_t)inlink->w * h + inlink->h / 2) / inlink->h, 1);
+    } else if (!h) {
+        h = FFMAX(((int64_t)inlink->h * w + inlink->w / 2) / inlink->w, 1);
+    }
+
+    if (w > INT_MAX || h > INT_MAX)
+        return AVERROR(EINVAL);
+
+    outlink->w = w;
+    outlink->h = h;
+    outlink->sample_aspect_ratio = inlink->sample_aspect_ratio;
+
+    if (s->rate.num > 0 && s->rate.den > 0) {
+        if (il->frame_rate.num <= 0 || il->frame_rate.den <= 0) {
+            av_log(ctx, AV_LOG_ERROR, "A frame rate change needs the input's frame rate.\n");
+            return AVERROR(EINVAL);
+        }
+        ol->frame_rate = s->rate;
+        outlink->time_base = av_inv_q(s->rate);
+        s->session_tb = SESSION_TIME_BASE;
+    } else {
+        ol->frame_rate = il->frame_rate;
+        outlink->time_base = inlink->time_base;
+        s->session_tb = inlink->time_base;
+    }
+
+    return 0;
+}
+
+/* the session's pixels of a format: planar Y'CbCr (one plane each, or Cb and Cr alternating
+ * in the second), or packed R'G'B' (layout 0) */
+static void pixels_of(const AVPixFmtDescriptor *desc, hdrg_session_pixfmt_t *pixels)
+{
+    memset(pixels, 0, sizeof(*pixels));
+
+    if (desc->flags & AV_PIX_FMT_FLAG_RGB) {
+        pixels->bits = desc->comp[0].depth > 8 ? 16 : 8;
+        return;
+    }
+
+    pixels->layout = desc->log2_chroma_h ? HDRG_YUV_420 :
+                     desc->log2_chroma_w ? HDRG_YUV_422 : HDRG_YUV_444;
+    pixels->bits        = desc->comp[0].depth;
+    pixels->interleaved = desc->comp[1].plane == desc->comp[2].plane;
+    pixels->msb         = !!desc->comp[0].shift;
+}
+
+/* the session over the first frame's size and colors */
+static int create_session(AVFilterContext *ctx, const AVFrame *in)
+{
+    LibHdrgradingContext *s = ctx->priv;
+    AVFilterLink *inlink = ctx->inputs[0];
+    AVFilterLink *outlink = ctx->outputs[0];
+    FilterLink *il = ff_filter_link(inlink);
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(in->format);
+    const AVPixFmtDescriptor *odesc = av_pix_fmt_desc_get(outlink->format);
+    hdrg_session_config_t *config = &s->config;
+    enum AVColorPrimaries primaries = in->color_primaries;
+    enum AVColorTransferCharacteristic trc = in->color_trc;
+    enum AVColorSpace matrix = in->colorspace;
+    int rgb = !!(desc->flags & AV_PIX_FMT_FLAG_RGB);
+    hdrg_status_t status;
+
+    if (trc == AVCOL_TRC_SMPTE2084 || trc == AVCOL_TRC_ARIB_STD_B67) {
+        av_log(ctx, AV_LOG_ERROR, "The input is HDR already (%s).\n",
+               av_color_transfer_name(trc));
+        return AVERROR(EINVAL);
+    }
+
+    if (primaries == AVCOL_PRI_UNSPECIFIED)
+        primaries = AVCOL_PRI_BT709;
+    if (trc == AVCOL_TRC_UNSPECIFIED)
+        trc = rgb ? AVCOL_TRC_IEC61966_2_1 : AVCOL_TRC_BT709;
+
+    memset(&s->format, 0, sizeof(s->format));
+    s->format.width     = in->width;
+    s->format.height    = in->height;
+    s->format.primaries = primaries;
+    s->format.transfer  = trc;
+
+    hdrg_session_config_init(config);
+    pixels_of(desc, &config->input);
+
+    if (rgb) {
+        s->format.bit_depth = config->input.bits;
+        s->format.stride    = in->linesize[0];
+        memset(&config->input, 0, sizeof(config->input));
+    } else {
+        if (matrix == AVCOL_SPC_UNSPECIFIED)
+            matrix = primaries == AVCOL_PRI_BT2020 ? AVCOL_SPC_BT2020_NCL :
+                     primaries == AVCOL_PRI_BT470BG || primaries == AVCOL_PRI_SMPTE170M ?
+                     AVCOL_SPC_SMPTE170M : AVCOL_SPC_BT709;
+        config->input.matrix = matrix == AVCOL_SPC_BT2020_NCL ? HDRG_MATRIX_BT2020 :
+                               matrix == AVCOL_SPC_BT709 ? HDRG_MATRIX_BT709 : HDRG_MATRIX_BT601;
+        config->input.full_range = in->color_range == AVCOL_RANGE_JPEG;
+        /* AVChromaLocation is H.273's chroma_sample_loc_type + 1 */
+        config->input.chroma_loc = in->chroma_location > AVCHROMA_LOC_UNSPECIFIED &&
+                                   in->chroma_location <= AVCHROMA_LOC_BOTTOM ?
+                                   in->chroma_location - 1 : HDRG_CHROMA_LEFT;
+    }
+
+    pixels_of(odesc, &config->output);
+    if (!(odesc->flags & AV_PIX_FMT_FLAG_RGB))
+        config->output.matrix = HDRG_MATRIX_BT2020;
+
+    if (il->frame_rate.num > 0 && il->frame_rate.den > 0) {
+        config->rate_num = il->frame_rate.num;
+        config->rate_den = il->frame_rate.den;
+    }
+    if (s->rate.num > 0 && s->rate.den > 0) {
+        config->out_rate_num = s->rate.num;
+        config->out_rate_den = s->rate.den;
+    }
+
+    config->output_width  = s->w;
+    config->output_height = s->h;
+    config->temporal      = s->temporal;
+    config->latency       = s->latency;
+    config->proxy         = s->proxy;
+    config->flash_off     = !s->flash_limit;
+    config->dither_off    = !s->dither;
+    if (s->past >= 0)
+        config->past = s->past;
+    config->future = s->future >= 0 ? s->future : HDRG_SESSION_AUTO;
+
+    status = hdrg_session_create(s->hdrg, &s->format, &s->params, &s->caps, config, &s->session);
+    if (status != HDRG_OK)
+        return hdrg_error(ctx, status, "Cannot create the libhdrgrading session");
+
+    s->peak = hdrg_session_peak(s->session);
+
+    return 0;
+}
+
+static void release_frame(void *opaque)
+{
+    AVFrame *frame = opaque;
+
+    av_frame_free(&frame);
+}
+
+/* the frame into the session, which holds it until its pixels are read */
+static int send_frame(AVFilterContext *ctx, AVFrame *in)
+{
+    LibHdrgradingContext *s = ctx->priv;
+    AVFilterLink *inlink = ctx->inputs[0];
+    hdrg_session_frame_t frame = { 0 };
+    hdrg_status_t status;
+    HdrgStamp stamp;
+    int64_t pts;
+    int ret;
+
+    if (!s->session && (ret = create_session(ctx, in)) < 0) {
+        av_frame_free(&in);
+        return ret;
+    }
+
+    if (in->width != s->format.width || in->height != s->format.height ||
+        (s->format.stride && in->linesize[0] != (int)s->format.stride) ||
+        in->linesize[0] <= 0 || in->linesize[1] < 0 || in->linesize[2] < 0) {
+        av_log(ctx, AV_LOG_ERROR, "The frames' size or layout changed.\n");
+        av_frame_free(&in);
+        return AVERROR(EINVAL);
+    }
+
+    pts = in->pts != AV_NOPTS_VALUE ? in->pts : s->sent;
+    pts = av_rescale_q(pts, inlink->time_base, s->session_tb);
+
+    stamp.pts   = pts;
+    stamp.props = av_frame_alloc();
+    if (!stamp.props || (ret = av_frame_copy_props(stamp.props, in)) < 0 ||
+        (ret = av_fifo_write(s->stamps, &stamp, 1)) < 0) {
+        av_frame_free(&stamp.props);
+        av_frame_free(&in);
+        return stamp.props ? ret : AVERROR(ENOMEM);
+    }
+
+    for (int p = 0; p < 3 && in->data[p]; p++) {
+        frame.planes[p]  = in->data[p];
+        frame.strides[p] = in->linesize[p];
+    }
+    frame.pts     = pts;
+    frame.release = release_frame;
+    frame.opaque  = in;
+
+    status = hdrg_session_send_frame(s->session, &frame);
+    if (status != HDRG_OK) {
+        av_frame_free(&in);
+        return hdrg_error(ctx, status, "Cannot send a frame");
+    }
+
+    s->sent++;
+
+    return 0;
+}
+
+static const enum AVFrameSideDataType dropped[] = {
+    AV_FRAME_DATA_MASTERING_DISPLAY_METADATA,
+    AV_FRAME_DATA_CONTENT_LIGHT_LEVEL,
+    AV_FRAME_DATA_ICC_PROFILE,
+    AV_FRAME_DATA_DYNAMIC_HDR_PLUS,
+    AV_FRAME_DATA_DYNAMIC_HDR_SMPTE_2094_APP5,
+    AV_FRAME_DATA_DYNAMIC_HDR_VIVID,
+    AV_FRAME_DATA_DOVI_RPU_BUFFER,
+    AV_FRAME_DATA_DOVI_METADATA,
+    AV_FRAME_DATA_AMBIENT_VIEWING_ENVIRONMENT,
+    AV_FRAME_DATA_FILM_GRAIN_PARAMS,
+    AV_FRAME_DATA_VIDEO_ENC_PARAMS,
+};
+
+/* the output's colors, mastering display and dynamic metadata */
+static int finish_frame(AVFilterContext *ctx, AVFrame *out, const hdrg_session_output_t *res)
+{
+    LibHdrgradingContext *s = ctx->priv;
+    static const AVRational p3[4][2] = {
+        { { 34000, 50000 }, { 16000, 50000 } }, { { 13250, 50000 }, { 34500, 50000 } },
+        { {  7500, 50000 }, {  3000, 50000 } }, { { 15635, 50000 }, { 16450, 50000 } },
+    };
+    AVMasteringDisplayMetadata *master;
+    AVDynamicHDRSmpte2094App5 *app5;
+    AVDynamicHDRPlus *plus;
+    uint8_t t35[FFMAX(HDRG_HDR10PLUS_T35_BYTES, HDRG_ST2094_50_T35_MAX)];
+    size_t size;
+    int rgb = !!(av_pix_fmt_desc_get(out->format)->flags & AV_PIX_FMT_FLAG_RGB);
+
+    for (int i = 0; i < FF_ARRAY_ELEMS(dropped); i++)
+        av_frame_remove_side_data(out, dropped[i]);
+
+    out->color_trc       = AVCOL_TRC_SMPTE2084;
+    out->color_primaries = AVCOL_PRI_BT2020;
+    out->colorspace      = rgb ? AVCOL_SPC_RGB : AVCOL_SPC_BT2020_NCL;
+    out->color_range     = rgb ? AVCOL_RANGE_JPEG : AVCOL_RANGE_MPEG;
+    out->chroma_location = rgb ? AVCHROMA_LOC_UNSPECIFIED : AVCHROMA_LOC_LEFT;
+
+    /* Display P3 (D65) up to the rendition ceiling */
+    master = av_mastering_display_metadata_create_side_data(out);
+    if (!master)
+        return AVERROR(ENOMEM);
+    for (int i = 0; i < 3; i++) {
+        master->display_primaries[i][0] = p3[i][0];
+        master->display_primaries[i][1] = p3[i][1];
+    }
+    master->white_point[0] = p3[3][0];
+    master->white_point[1] = p3[3][1];
+    master->min_luminance  = av_make_q(50, 10000);
+    master->max_luminance  = av_make_q(lrintf(s->peak * 10000.0f), 10000);
+    master->has_primaries  = 1;
+    master->has_luminance  = 1;
+
+    size = hdrg_hdr10plus_t35(&res->hdr10plus, t35, sizeof(t35));
+    if (size) {
+        plus = av_dynamic_hdr_plus_create_side_data(out);
+        if (!plus)
+            return AVERROR(ENOMEM);
+        if (av_dynamic_hdr_plus_from_t35(plus, t35, size) < 0)
+            return AVERROR_BUG;
+        plus->itu_t_t35_country_code = 0xB5;
+    }
+
+    size = hdrg_st2094_50_t35(&res->st2094_50, t35, sizeof(t35));
+    if (size) {
+        app5 = av_dynamic_hdr_smpte2094_app5_create_side_data(out);
+        if (!app5)
+            return AVERROR(ENOMEM);
+        if (av_dynamic_hdr_smpte2094_app5_from_t35(app5, t35, size) < 0)
+            return AVERROR_BUG;
+    }
+
+    return 0;
+}
+
+/* one frame out of the session, if it has one: 1 sent on, 0 none yet, AVERROR_EOF the end */
+static int receive_frame(AVFilterContext *ctx)
+{
+    LibHdrgradingContext *s = ctx->priv;
+    AVFilterLink *outlink = ctx->outputs[0];
+    hdrg_session_output_t res = { 0 };
+    hdrg_status_t status;
+    HdrgStamp stamp;
+    AVFrame *out;
+    int64_t want;
+    int ret;
+
+    out = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+    if (!out)
+        return AVERROR(ENOMEM);
+
+    for (int p = 0; p < 3 && out->data[p]; p++) {
+        res.planes[p]  = out->data[p];
+        res.strides[p] = out->linesize[p];
+    }
+
+    status = hdrg_session_receive_frame(s->session, &res);
+    if (status == HDRG_ERR_AGAIN || status == HDRG_EOF) {
+        av_frame_free(&out);
+        return status == HDRG_EOF ? AVERROR_EOF : 0;
+    }
+    if (status != HDRG_OK) {
+        av_frame_free(&out);
+        return hdrg_error(ctx, status, "Cannot receive a frame");
+    }
+
+    /* the input frame's properties (a frame between two: the nearer one's) */
+    want = !res.synthetic ? res.pts : res.src_pts[res.phase < 32768 ? 0 : 1];
+    while (av_fifo_can_read(s->stamps) > 1 && av_fifo_peek(s->stamps, &stamp, 1, 0) >= 0 &&
+           stamp.pts < want) {
+        av_fifo_drain2(s->stamps, 1);
+        av_frame_free(&stamp.props);
+    }
+
+    if (av_fifo_peek(s->stamps, &stamp, 1, 0) >= 0 &&
+        (ret = av_frame_copy_props(out, stamp.props)) < 0) {
+        av_frame_free(&out);
+        return ret;
+    }
+
+    /* without fps one output a frame, in order (timestamps or none): its properties done */
+    if (!(s->rate.num > 0 && s->rate.den > 0) && av_fifo_read(s->stamps, &stamp, 1) >= 0)
+        av_frame_free(&stamp.props);
+
+    if (s->rate.num > 0 && s->rate.den > 0) {
+        out->pts      = av_rescale_q(res.pts, s->session_tb, outlink->time_base);
+        out->duration = 1;
+    } else {
+        out->pts = res.pts;
+    }
+
+    if ((ret = finish_frame(ctx, out, &res)) < 0) {
+        av_frame_free(&out);
+        return ret;
+    }
+
+    ret = ff_filter_frame(outlink, out);
+
+    return ret < 0 ? ret : 1;
+}
+
+/* every frame the session has out: *got set when one went on */
+static int drain(AVFilterContext *ctx, int *got)
+{
+    LibHdrgradingContext *s = ctx->priv;
+    int ret = 0;
+
+    while (s->session && (ret = receive_frame(ctx)) > 0)
+        *got = 1;
+
+    return ret == AVERROR_EOF ? 0 : ret;
+}
+
+static int activate(AVFilterContext *ctx)
+{
+    LibHdrgradingContext *s = ctx->priv;
+    AVFilterLink *inlink = ctx->inputs[0];
+    AVFilterLink *outlink = ctx->outputs[0];
+    hdrg_status_t status;
+    AVFrame *in;
+    int64_t pts;
+    int ret, err, got = 0;
+
+    FF_FILTER_FORWARD_STATUS_BACK(outlink, inlink);
+
+    /* the frames out first, then each input frame into the session */
+    if ((ret = drain(ctx, &got)) < 0)
+        return ret;
+
+    while ((ret = ff_inlink_consume_frame(inlink, &in)) > 0) {
+        if ((ret = send_frame(ctx, in)) < 0 || (ret = drain(ctx, &got)) < 0)
+            return ret;
+    }
+    if (ret < 0)
+        return ret;
+
+    if (got)
+        return 0;
+
+    /* the end: every frame the session holds out */
+    if (ff_inlink_acknowledge_status(inlink, &ret, &pts)) {
+        if (s->session) {
+            status = hdrg_session_send_frame(s->session, NULL);
+            if (status != HDRG_OK)
+                return hdrg_error(ctx, status, "Cannot end the stream");
+            if ((err = drain(ctx, &got)) < 0)
+                return err;
+        }
+        ff_outlink_set_status(outlink, ret, av_rescale_q(pts, inlink->time_base,
+                                                         outlink->time_base));
+        return 0;
+    }
+
+    FF_FILTER_FORWARD_WANTED(outlink, inlink);
+
+    return FFERROR_NOT_READY;
+}
