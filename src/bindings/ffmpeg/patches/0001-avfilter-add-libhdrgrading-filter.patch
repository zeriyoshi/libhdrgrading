 doc/filters.texi               |  86 ++++
 libavfilter/Makefile           |   1 +
 libavfilter/allfilters.c       |   1 +
 libavfilter/vf_libhdrgrading.c | 668 +++++++++++++++++++++++++++++++++
 5 files changed, 760 insertions(+)
 create mode 100644 libavfilter/vf_libhdrgrading.c

