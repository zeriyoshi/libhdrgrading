{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 29,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/$env{HDRG_BUILD_PREFIX}${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HDRG_WITH_SIMD_FMA": "OFF"
            }
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "dev",
            "displayName": "Debug",
            "inherits": "debug"
        },
        {
            "name": "release",
            "displayName": "Release (shared library)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_SHARED_LIBS": "ON"
            }
        },
        {
            "name": "nolcms2",
            "displayName": "Debug without lcms2 (no P3 / PQ profiles: GAINMAP only)",
            "inherits": "debug",
            "cacheVariables": {
                "HDRG_WITH_LCMS2": "OFF"
            }
        },
        {
            "name": "minimal",
            "displayName": "Debug without the optional built-in filters and codecs (HDRG_PLUGINS_EXCLUDE: Lanczos and JPEG alone)",
            "inherits": "debug",
            "cacheVariables": {
                "HDRG_PLUGINS_EXCLUDE": "filters;png;gif;jxl"
            }
        },
        {
            "name": "temporal",
            "displayName": "Debug with the temporal filters of the video statistics, the motion-compensated interpolation and the multi-frame upscale (off by default)",
            "inherits": "debug",
            "cacheVariables": {
                "HDRG_WITH_TEMPORAL": "ON"
            }
        },
        {
            "name": "heif",
            "displayName": "Debug with HEIF (libheif: the system's, else fetched with libde265 and x265 at build time)",
            "inherits": "debug",
            "cacheVariables": {
                "HDRG_WITH_HEIF": "ON"
            }
        },
        {
            "name": "avif",
            "displayName": "Debug with the AVIF module (the system's libavif, by pkg-config)",
            "inherits": "debug",
            "cacheVariables": {
                "HDRG_WITH_AVIF": "ON"
            }
        },
        {
            "name": "asan-ubsan",
            "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "HDRG_SANITIZER": "address-undefined"
            }
        },
        {
            "name": "tsan",
            "displayName": "ThreadSanitizer",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "HDRG_SANITIZER": "thread"
            }
        },
        {
            "name": "msan-core",
            "displayName": "MemorySanitizer (the core without the codecs, Linux + Clang)",
            "inherits": [
                "base",
                "clang"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "HDRG_SANITIZER": "memory",
                "HDRG_PLUGINS_EXCLUDE": "codecs"
            }
        },
        {
            "name": "valgrind",
            "displayName": "Valgrind memcheck",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_TEST_LAUNCHER": "valgrind;--error-exitcode=1;--leak-check=full;--errors-for-leak-kinds=definite;--track-origins=yes",
                "HDRG_WITH_WEBGPU": "OFF",
                "HDRG_WITH_VULKAN": "OFF"
            }
        },
        {
            "name": "coverage",
            "displayName": "Clang source-based coverage (the temporal features on: every source measured)",
            "inherits": [
                "debug",
                "clang"
            ],
            "cacheVariables": {
                "HDRG_COVERAGE": "ON",
                "HDRG_WITH_TEMPORAL": "ON"
            }
        },
        {
            "name": "coverage-msvc",
            "displayName": "Clang source-based coverage with clang-cl (Windows; Ninja, the target of the developer prompt, -m32 in CFLAGS for x86)",
            "inherits": "debug",
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "HDRG_COVERAGE": "ON",
                "HDRG_WITH_TEMPORAL": "ON"
            }
        },
        {
            "name": "fuzz",
            "displayName": "libFuzzer + ASan/UBSan",
            "inherits": [
                "base",
                "clang"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "HDRG_SANITIZER": "address-undefined",
                "HDRG_BUILD_FUZZERS": "ON",
                "HDRG_BUILD_TESTS": "OFF",
                "HDRG_BUILD_TOOLS": "OFF"
            }
        },
        {
            "name": "wasm-base",
            "hidden": true,
            "inherits": "base",
            "toolchainFile": "$env{HDRG_EMSDK_DIR}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "wasm",
            "displayName": "WASM SIMD128, single thread (the demo's default)",
            "inherits": "wasm-base"
        },
        {
            "name": "wasm-mt",
            "displayName": "WASM SIMD128, pthreads",
            "inherits": "wasm-base",
            "cacheVariables": {
                "HDRG_WASM_THREADS": "ON"
            }
        },
        {
            "name": "wasm-scalar",
            "displayName": "WASM scalar, single thread",
            "inherits": "wasm-base",
            "cacheVariables": {
                "HDRG_WITH_SIMD": "OFF"
            }
        },
        {
            "name": "wasm-scalar-mt",
            "displayName": "WASM scalar, pthreads",
            "inherits": "wasm-base",
            "cacheVariables": {
                "HDRG_WASM_THREADS": "ON",
                "HDRG_WITH_SIMD": "OFF"
            }
        },
        {
            "name": "wasm-webgpu",
            "displayName": "WASM SIMD128 with WebGPU (emdawnwebgpu, JSPI), single thread",
            "inherits": "wasm-base",
            "cacheVariables": {
                "HDRG_WASM_WEBGPU": "ON"
            }
        },
        {
            "name": "wasm-debug",
            "displayName": "WASM SIMD128, single thread, Debug",
            "inherits": "wasm-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HDRG_WITH_SIMD_FMA": "OFF"
            }
        }
    ],
