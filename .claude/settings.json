{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude_style_hook.sh",
            "timeout": 30,
            "statusMessage": "Checking C style (scripts/check_style.py)"
          }
        ]
      }
    ]
  }
}
