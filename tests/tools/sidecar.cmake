# test_video_sidecar: hdrg-video's sidecars of 16 raw RGB frames with a scene cut at the 8th.
# HDR10+'s JSON (hdr10plus_tool's, profile A): one entry a frame in order, one window, the 9
# percentiles at their percentages rising, the scenes (their ids, the frames' places in them and
# the summary); ST 2094-50's: one entry a frame with its pts and scene, the fields as its T.35
# payload in hex holds them (one alternate at headroom 0, PCHIP slopes).
#
#   cmake -DVIDEO=<hdrg-video> -DWORK_DIR=<dir> -P tests/tools/sidecar.cmake
cmake_minimum_required(VERSION 3.29)

set(width 64)
set(height 32)
set(frames 16)
set(cut 8)

# the frames' bytes printable (32 ' ', 80 'P', 64 '@', 126 '~'): two flat halves, then a checker
file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
string(REPEAT " " 96 dark)
string(REPEAT "P" 96 light)
string(REPEAT "${dark}${light}" ${height} halves)
string(REPEAT "@@@@@@@@@@@@~~~~~~~~~~~~" 8 even)
string(REPEAT "~~~~~~~~~~~~@@@@@@@@@@@@" 8 odd)
string(REPEAT "${even}" 4 even)
string(REPEAT "${odd}" 4 odd)
string(REPEAT "${even}${odd}" 4 checker)
string(REPEAT "${halves}" ${cut} input)
math(EXPR after "${frames} - ${cut}")
string(REPEAT "${checker}" ${after} rest)
file(WRITE "${WORK_DIR}/in.rgb" "${input}${rest}")
file(SIZE "${WORK_DIR}/in.rgb" size)
math(EXPR want "${width} * ${height} * 3 * ${frames}")
if(NOT size EQUAL want)
    message(FATAL_ERROR "the input has ${size} bytes, not ${want}")
endif()

execute_process(COMMAND "${VIDEO}" --size ${width}x${height}
    --hdr10plus-json "${WORK_DIR}/hdr10plus.json" --st2094-50-json "${WORK_DIR}/st2094_50.json"
    "${WORK_DIR}/in.rgb" "${WORK_DIR}/out.rgb"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "hdrg-video failed (${result}):\n${error}")
endif()

function(expect what got want)
    if(NOT "${got}" STREQUAL "${want}")
        message(FATAL_ERROR "${what}: ${got}, not ${want}")
    endif()
endfunction()

# HDR10+
file(READ "${WORK_DIR}/hdr10plus.json" plus)
string(JSON profile GET "${plus}" JSONInfo HDR10plusProfile)
expect("the profile" "${profile}" "A")
string(JSON count LENGTH "${plus}" SceneInfo)
expect("HDR10+ entries" "${count}" "${frames}")
math(EXPR last "${frames} - 1")
foreach(i RANGE ${last})
    string(JSON entry GET "${plus}" SceneInfo ${i})
    string(JSON index GET "${entry}" SequenceFrameIndex)
    expect("entry ${i}'s frame" "${index}" "${i}")
    string(JSON windows GET "${entry}" NumberOfWindows)
    expect("entry ${i}'s windows" "${windows}" "1")
    string(JSON scene GET "${entry}" SceneId)
    string(JSON place GET "${entry}" SceneFrameIndex)
    if(i LESS cut)
        expect("entry ${i}'s scene" "${scene}" "0")
        expect("entry ${i}'s place" "${place}" "${i}")
    else()
        math(EXPR within "${i} - ${cut}")
        expect("entry ${i}'s scene" "${scene}" "1")
        expect("entry ${i}'s place" "${place}" "${within}")
    endif()

    string(JSON maxscl GET "${entry}" LuminanceParameters MaxScl)
    string(JSON channels LENGTH "${maxscl}")
    expect("entry ${i}'s MaxScl" "${channels}" "3")
    set(brightest 0)
    foreach(c RANGE 2)
        string(JSON v GET "${maxscl}" ${c})
        if(v GREATER brightest)
            set(brightest ${v})
        endif()
    endforeach()
    string(JSON average GET "${entry}" LuminanceParameters AverageRGB)
    if(average GREATER brightest OR brightest EQUAL 0)
        message(FATAL_ERROR "entry ${i}: AverageRGB ${average}, MaxScl ${maxscl}")
    endif()

    string(JSON distribution GET "${entry}" LuminanceParameters LuminanceDistributions)
    set(percentages "")
    set(previous 0)
    foreach(k RANGE 8)
        string(JSON percentage GET "${distribution}" DistributionIndex ${k})
        list(APPEND percentages ${percentage})
        string(JSON v GET "${distribution}" DistributionValues ${k})
        if(v LESS previous OR v GREATER brightest)
            message(FATAL_ERROR "entry ${i}: the percentiles ${distribution}")
        endif()
        set(previous ${v})
    endforeach()
    expect("entry ${i}'s percentages" "${percentages}" "1;5;10;25;50;75;90;95;99")
endforeach()

foreach(field IN ITEMS SceneFirstFrameIndex SceneFrameNumbers)
    string(JSON scenes LENGTH "${plus}" SceneInfoSummary ${field})
    expect("the summary's ${field}" "${scenes}" "2")
endforeach()
string(JSON v GET "${plus}" SceneInfoSummary SceneFirstFrameIndex 1)
expect("the second scene's first frame" "${v}" "${cut}")
string(JSON v GET "${plus}" SceneInfoSummary SceneFrameNumbers 1)
expect("the second scene's frames" "${v}" "${after}")

# ST 2094-50: the fields read from the payload's hex (one alternate: no custom white)
file(READ "${WORK_DIR}/st2094_50.json" st)
string(JSON header GET "${st}" T35Header)
expect("the T.35 header" "${header}" "B500900001")
string(JSON count LENGTH "${st}" Frames)
expect("ST 2094-50 entries" "${count}" "${frames}")
set(fitted 0)
foreach(i RANGE ${last})
    string(JSON entry GET "${st}" Frames ${i})
    string(JSON index GET "${entry}" SequenceFrameIndex)
    expect("frame ${i}" "${index}" "${i}")
    string(JSON pts GET "${entry}" Pts)
    expect("frame ${i}'s pts" "${pts}" "${i}")
    string(JSON scene GET "${entry}" SceneId)
    if(i LESS cut)
        expect("frame ${i}'s scene" "${scene}" "0")
    else()
        expect("frame ${i}'s scene" "${scene}" "1")
    endif()

    string(JSON hex GET "${entry}" T35)
    if(hex STREQUAL "")
        continue()
    endif()

    math(EXPR fitted "${fitted} + 1")
    string(SUBSTRING "${hex}" 0 4 head)
    expect("frame ${i}'s flags" "${head}" "0040")
    string(JSON white GET "${entry}" HdrReferenceWhite)
    expect("frame ${i}'s white" "${white}" "1015")
    string(SUBSTRING "${hex}" 4 4 v)
    math(EXPR v "0x${v}")
    string(JSON baseline GET "${entry}" BaselineHdrHeadroom)
    expect("frame ${i}'s baseline" "${baseline}" "${v}")
    string(SUBSTRING "${hex}" 8 2 v)
    math(EXPR alternates "(0x${v} >> 4) & 7")
    math(EXPR space "(0x${v} >> 2) & 3")
    expect("frame ${i}'s alternates" "${alternates}" "1")
    string(JSON v GET "${entry}" GainApplicationSpaceChromaticities)
    expect("frame ${i}'s space" "${v}" "${space}")
    string(JSON alternate GET "${entry}" Alternates 0)
    string(JSON v GET "${alternate}" AlternateHdrHeadroom)
    expect("frame ${i}'s headroom" "${v}" "0")
    string(JSON v GET "${alternate}" GainCurveUsePchipSlope)
    expect("frame ${i}'s PCHIP" "${v}" "ON")
    string(JSON points LENGTH "${alternate}" GainCurveControlPointsX)
    string(JSON v LENGTH "${alternate}" GainCurveControlPointsY)
    expect("frame ${i}'s y" "${v}" "${points}")
    string(LENGTH "${hex}" length)
    math(EXPR want "(9 + ${points} * 4) * 2")
    expect("frame ${i}'s payload" "${length}" "${want}")
    math(EXPR last_point "${points} - 1")
    foreach(k RANGE ${last_point})
        math(EXPR x_at "18 + ${k} * 4")
        math(EXPR y_at "18 + (${points} + ${k}) * 4")
        string(SUBSTRING "${hex}" ${x_at} 4 x)
        string(SUBSTRING "${hex}" ${y_at} 4 y)
        math(EXPR x "0x${x}")
        math(EXPR y "0x${y}")
        string(JSON v GET "${alternate}" GainCurveControlPointsX ${k})
        expect("frame ${i}'s x ${k}" "${v}" "${x}")
        string(JSON v GET "${alternate}" GainCurveControlPointsY ${k})
        expect("frame ${i}'s y ${k}" "${v}" "${y}")
    endforeach()
endforeach()
if(fitted EQUAL 0)
    message(FATAL_ERROR "no frame has a gain curve")
endif()
